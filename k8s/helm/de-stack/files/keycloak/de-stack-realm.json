{
  "realm": "de-stack",
  "enabled": true,
  "sslRequired": "none",
  "loginWithEmailAllowed": true,
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "unity-catalog",
      "name": "Unity Catalog",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "unity-catalog-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:8989",
        "http://localhost:8989/*",
        "http://127.0.0.1:8989",
        "http://127.0.0.1:8989/*",
        "http://localhost:3000/*",
        "http://uc-ui.de.lan/*"
      ],
      "webOrigins": [
        "+"
      ]
    },
    {
      "clientId": "unity-catalog-ui",
      "name": "Unity Catalog Web UI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "https://uc-ui.de.lan/*",
        "http://uc-ui.de.lan/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "polaris",
      "name": "Apache Polaris (engines/API)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "polaris-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "principal_name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "principal_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "principal_roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "principal_roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "polaris-ui",
      "name": "Apache Polaris Console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8189/*",
        "http://polaris-console.de.lan/*"
      ],
      "webOrigins": [
        "http://localhost:8189",
        "http://polaris-console.de.lan"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "principal_name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "principal_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "principal_roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "principal_roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "analyst",
      "enabled": true,
