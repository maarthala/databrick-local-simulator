# Single shared variables file for ALL stacks (base-setup, sql, sql-seed).
# Copy to common.tfvars (gitignored) and pass it to every stack:
#   cd base-setup && terraform apply -var-file=../common.tfvars
#   cd sql        && terraform apply -var-file=../common.tfvars
#   cd sql-seed   && terraform apply -var-file=../common.tfvars
#
# Each stack uses the variables it declares; the rest print a harmless
# "Value for undeclared variable" warning (add -compact-warnings to trim).
# Values that DIFFER per stack (location, resource group, database name) are NOT
# here — they come from each stack's own defaults in variables.tf.

# --- shared everywhere ---
subscription_id = "00000000-0000-0000-0000-000000000000" # azur-learning
prefix          = "epireum"                              # static, globally-unique naming

# --- SQL (sql/ + sql-seed/) ---
sql_admin_login    = "sqladmin"
sql_admin_password = "qwert@123456" # change for anything real

# --- Git integration (base-setup/) ---
git_account_name    = "maarthala"
git_repository_name = "azure-learning"
git_branch_name     = "main"
git_root_folder     = "/adf"
