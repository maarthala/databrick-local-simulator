# Copy to terraform.tfvars (gitignored) and fill in.

# Or export ARM_SUBSCRIPTION_ID instead of setting this.
subscription_id = "a0e23f01-2a2a-4ad5-a714-b0e35e5bd7de" # azur-learning

location            = "northeurope"
resource_group_name = "rg-adf-dev"
name_prefix         = "adfdev"

# --- Git integration (GitHub). Leave git_repository_name empty to skip Git for now.
git_account_name    = "maarthala"     # your GitHub org/username
git_repository_name = "adf-pipelines" # a repo for the ADF JSON (create it first, or reuse one)
git_branch_name     = "main"
git_root_folder     = "/"
