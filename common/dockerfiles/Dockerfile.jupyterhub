# JupyterHub (local stack): Keycloak login (oauthenticator), one Jupyter container per
# learner (dockerspawner), idle culling, and the per-learner lakehouse spawn hook
# (lakehouse.py, shared with home-api). Hub version = Zero-to-JupyterHub 4.4.2's (5.5.2),
# so local matches the k8s chart.
FROM quay.io/jupyterhub/jupyterhub:5.5.2
RUN python3 -m pip install --no-cache-dir \
      "jupyterhub==5.5.2" "oauthenticator==17.4.0" "dockerspawner==14.0.0" \
      "jupyterhub-idle-culler==2.0.0"
COPY add/lakehouse.py /srv/jupyterhub/lakehouse.py
COPY add/jupyterhub_config.py /srv/jupyterhub/jupyterhub_config.py
WORKDIR /srv/jupyterhub
ENV PYTHONPATH=/srv/jupyterhub
RUN mkdir -p /srv/jupyterhub/data
CMD ["jupyterhub", "-f", "/srv/jupyterhub/jupyterhub_config.py"]
