FROM apache/superset:6.1.0

USER root

# Superset 5+ runs from a virtualenv (/app/.venv); plain `pip` is the SYSTEM python, so
# drivers installed with it are invisible to Superset. Install into the venv with uv.
# psycopg2 = metadata DB (Postgres); trino[sqlalchemy] = the Trino dialect (replaces the
# deprecated sqlalchemy-trino). SQLAlchemy stays on the 1.4 line Superset ships with.
RUN uv pip install --python /app/.venv/bin/python --no-cache \
    "SQLAlchemy==1.4.54" \
    "trino[sqlalchemy]" \
    "psycopg2-binary" "authlib"

USER superset
COPY ./add/connections.py /extras/connections.py
# superset_config.py is auto-loaded from PYTHONPATH (/app/pythonpath) — points metadata at Postgres
COPY ./add/superset_config.py /app/pythonpath/superset_config.py
