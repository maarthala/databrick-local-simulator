# Slim Airflow for Kubernetes: no baked-in Spark. Spark jobs are run in separate
# pods via KubernetesPodOperator (the cncf.kubernetes provider), so this image
# stays small and mounts fast.
FROM apache/airflow:3.3.2-python3.10

# cncf.kubernetes = KubernetesPodOperator; papermill for the notebook DAG.
# pyspark-client = thin Spark Connect client (no JVM), so an Airflow @task can
# import shared src/mylib and drive sc://spark-connect:15002 in-process.
# (Login uses SimpleAuthManager with a pinned airflow/airflow password, set in
# the k8s Deployment startup — so the FAB provider isn't needed here.)
# Pin airflow + install against the release's constraints so pip can't swap the
# core version or pull provider versions that weren't tested with it.
# pyspark-client is pinned to the Spark server version (4.1.3), overriding constraints.
ARG AIRFLOW_VERSION=3.3.2
RUN curl -fsSL -o /tmp/constraints.txt \
      "https://raw.githubusercontent.com/apache/airflow/constraints-${AIRFLOW_VERSION}/constraints-3.10.txt" \
 && sed -i '/^pyspark-client==/d' /tmp/constraints.txt \
 && pip install --no-cache-dir --constraint /tmp/constraints.txt \
      "apache-airflow==${AIRFLOW_VERSION}" \
      apache-airflow-providers-cncf-kubernetes \
      papermill \
      pyspark-client==4.1.3 \
      ipykernel \
 && python -m ipykernel install --user --name python3 --display-name "Python 3"
