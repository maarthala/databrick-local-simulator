# Polaris Console with lab SSO behaviour (the upstream console hard-codes these):
#  - drop `prompt: "login"` from its OIDC request, so an existing Keycloak session signs
#    in silently instead of asking for the password again;
#  - label the OIDC button "Sign in with Epireum lab account";
#  - auto-start that sign-in on /login (polaris-console-sso.js); /login?local=1 keeps the
#    Client ID / Secret form for root and the personas.
# The patched bundle and the SSO script get content-hashed file names (browsers cache
# the originals forever).
# The build fails if the upstream bundle no longer contains the patched strings.
FROM apache/polaris-console:latest
USER 0
COPY add/polaris-console-sso.js /opt/app-root/src/lab-sso.js
RUN set -e; cd /opt/app-root/src; B=$(ls assets/index-*.js); \
    grep -q 'prompt:"login"' "$B"; grep -q 'Sign in with OIDC' "$B"; \
    sed -i -e 's/,prompt:"login"//' -e 's/Sign in with OIDC/Sign in with Epireum lab account/' "$B"; \
    ! grep -q 'prompt:"login"' "$B"; \
    J="lab-sso-$(md5sum lab-sso.js | cut -c1-8).js"; mv lab-sso.js "$J"; \
    sed -i "s#<script src=\"/config.js\"></script>#<script src=\"/config.js\"></script>\n    <script src=\"/$J\"></script>#" index.html; \
    N="assets/index-labsso-$(md5sum "$B" | cut -c1-8).js"; mv "$B" "$N"; \
    sed -i "s#/$B#/$N#" index.html; grep -q "/$N" index.html; \
    grep -q 'lab-sso-' index.html; \
    chown -R polaris /opt/app-root/src
# The page itself (index.html, every SPA route) must be re-checked, or browsers keep the
# old console after an update (the hashed .js bundles may stay cached). Local had this from
# the polaris-proxy; on k8s the ingress talks to this nginx directly.
RUN set -e; F=/opt/app-root/etc/nginx.default.d/default.conf; \
    sed -i 's#try_files $uri $uri/ /index.html;#try_files $uri $uri/ /index.html;\n        add_header Cache-Control "no-cache" always;\n        add_header X-Frame-Options "SAMEORIGIN" always;\n        add_header X-Content-Type-Options "nosniff" always;#' "$F"; \
    grep -q 'Cache-Control "no-cache"' "$F"
USER polaris
