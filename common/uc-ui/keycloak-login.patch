 import axios from 'axios';
 import { UC_API_PREFIX } from '../utils/constants';
 
+// Where the UC access token from the OIDC exchange is kept.
+export const UC_TOKEN_STORAGE_KEY = 'uc_token';
+
 /**
  * The singleton client instance with `baseURL`.
  */
@@ -10,3 +13,15 @@ export const CLIENT = axios.create({
     'Content-type': 'application/json',
   },
 });
+
+// Authenticate every request with the stored UC token as a Bearer header. UC's
+// session cookie is set Secure-only, which the browser drops on a plain-http
+// origin, so a header (not the cookie) is what keeps the UI authenticated here.
+CLIENT.interceptors.request.use((config) => {
+  const token = localStorage.getItem(UC_TOKEN_STORAGE_KEY);
+  if (token) {
+    config.headers = config.headers ?? {};
+    (config.headers as any).Authorization = `Bearer ${token}`;
+  }
+  return config;
+});
