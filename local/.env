# User id the Airflow containers run as (match your host UID on Linux).
AIRFLOW_UID=501

# Single source of truth for the compose files that make up the stack.
# docker compose reads COMPOSE_FILE automatically, so `docker compose up`,
# env-up.sh, and the Makefile all target the same services without repeating
# this list. Paths are relative to the repo root (run compose from there).
COMPOSE_FILE=base.yaml:db.yaml:minio.yaml:spark.yaml:airflow.yaml:jupyter.yaml:superset.yaml:home.yaml:keycloak.yaml:unity-catalog.yaml
